//@version=6
indicator(title = 'TRADE_to_WIN-WEBHOOK', overlay = true)

// Inputs
a = input(2, title = 'Key Vaule. \'This changes the sensitivity\'')
c = input(10, title = 'ATR Period')
h = input(false, title = 'Signals from Heikin Ashi Candles')
history_of_zones = input.int(20, title = 'Max Zone History', minval = 5, maxval = 50)
zone_extension = input.int(100, title = 'Zone Extension (Bars)', minval = 10, maxval = 500)


xATR = ta.atr(c)
nLoss = a * xATR

src = h ? request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close, lookahead = barmerge.lookahead_off) : close

xATRTrailingStop = 0.0
iff_1 = src > nz(xATRTrailingStop[1], 0) ? src - nLoss : src + nLoss
iff_2 = src < nz(xATRTrailingStop[1], 0) and src[1] < nz(xATRTrailingStop[1], 0) ? math.min(nz(xATRTrailingStop[1]), src + nLoss) : iff_1
xATRTrailingStop := src > nz(xATRTrailingStop[1], 0) and src[1] > nz(xATRTrailingStop[1], 0) ? math.max(nz(xATRTrailingStop[1]), src - nLoss) : iff_2

// Stochastic RSI Hesaplama (Version 6 ile uyumlu)
smoothK = input.int(3, 'K', minval = 1)
smoothD = input.int(3, 'D', minval = 1)
lengthRSI = input.int(14, 'RSI Length', minval = 1)
lengthStoch = input.int(14, 'Stochastic Length', minval = 1)

rsi1 = ta.rsi(close, lengthRSI)
k = ta.sma(ta.stoch(rsi1, rsi1, rsi1, lengthStoch), smoothK)
d = ta.sma(k, smoothD)


// Tablo
var table stochTable = table.new(position.top_right, 2, 2, bgcolor = color.new(color.blue, 70))
table.cell(stochTable, 0, 0, 'Stoch RSI (K)', text_color = color.white)
table.cell(stochTable, 0, 1, str.tostring(k, '#.##'), text_color = color.white)

pos = 0
iff_3 = src[1] > nz(xATRTrailingStop[1], 0) and src < nz(xATRTrailingStop[1], 0) ? -1 : nz(pos[1], 0)
pos := src[1] < nz(xATRTrailingStop[1], 0) and src > nz(xATRTrailingStop[1], 0) ? 1 : iff_3

xcolor = pos == -1 ? color.red : pos == 1 ? color.green : color.blue

ema = ta.ema(src, 1)
above = ta.crossover(ema, xATRTrailingStop)
below = ta.crossover(xATRTrailingStop, ema)

buy = src > xATRTrailingStop and above
sell = src < xATRTrailingStop and below

barbuy = src > xATRTrailingStop
barsell = src < xATRTrailingStop

plotshape(buy, title = 'Buy', text = 'AL', style = shape.labelup, location = location.belowbar, color = color.new(color.green, 0), textcolor = color.new(color.white, 0), size = size.tiny)
plotshape(sell, title = 'Sell', text = 'SAT', style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0), textcolor = color.new(color.white, 0), size = size.tiny)

barcolor(barbuy ? color.rgb(6, 250, 14) : na)
barcolor(barsell ? color.red : na)

//      INDICATOR SETTINGS
swing_length = input.int(10, title = 'Swing High/Low Length', group = 'Settings', minval = 1, maxval = 50)
history_of_demand_to_keep = input.int(20, title = 'History To Keep', minval = 5, maxval = 50)
box_width = input.float(10, title = 'Supply/Demand Box Width', group = 'Settings', minval = 1, maxval = 10, step = 0.5)

supply_color = input.color(color.new(#f10808, 45), title = 'Supply', group = 'Visual Settings', inline = '3')
supply_outline_color = input.color(color.new(#0505058f, 75), title = 'Outline', group = 'Visual Settings', inline = '3')

demand_color = input.color(color.new(#00FFFF, 70), title = 'Demand', group = 'Visual Settings', inline = '4')
demand_outline_color = input.color(#0505058f, title = 'Outline', group = 'Visual Settings', inline = '4')

bos_label_color = input.color(#0505058f, title = 'BOS Label', group = 'Visual Settings', inline = '5')
poi_label_color = input.color(#0505058f, title = 'POI Label', group = 'Visual Settings', inline = '7')

f_array_add_pop(array, new_value_to_add) =>
    array.unshift(array, new_value_to_add)
    array.pop(array)

f_check_overlapping(new_poi, box_array, atr) =>

    atr_threshold = atr * 2
    okay_to_draw = true

    for i = 0 to array.size(box_array) - 1 by 1
        top = box.get_top(array.get(box_array, i))
        bottom = box.get_bottom(array.get(box_array, i))
        poi = (top + bottom) / 2

        upper_boundary = poi + atr_threshold
        lower_boundary = poi - atr_threshold

        if new_poi >= lower_boundary and new_poi <= upper_boundary
            okay_to_draw := false
            break
        else
            okay_to_draw := true
            okay_to_draw
    okay_to_draw


f_supply_demand(value_array, bn_array, box_array, label_array, box_type, atr) =>

    atr_buffer = atr * (box_width / 10)
    box_left = array.get(bn_array, 0)
    box_right = bar_index

    var float box_top = 0.00
    var float box_bottom = 0.00
    var float poi = 0.00


    if box_type == 1
        box_top := array.get(value_array, 0)
        box_bottom := box_top - atr_buffer
        poi := (box_top + box_bottom) / 2
        poi
    else if box_type == -1
        box_bottom := array.get(value_array, 0)
        box_top := box_bottom + atr_buffer
        poi := (box_top + box_bottom) / 2
        poi

    okay_to_draw = f_check_overlapping(poi, box_array, atr)

    if box_type == 1 and okay_to_draw
        box.delete(array.get(box_array, array.size(box_array) - 1))
        f_array_add_pop(box_array, box.new(left = box_left, top = box_top, right = box_right, bottom = box_bottom, border_color = supply_outline_color, bgcolor = supply_color, extend = extend.right, text = 'DİRENÇ', text_halign = text.align_center, text_valign = text.align_center, text_color = poi_label_color, text_size = size.small, xloc = xloc.bar_index))

        box.delete(array.get(label_array, array.size(label_array) - 1))
        f_array_add_pop(label_array, box.new(left = box_left, top = poi, right = box_right, bottom = poi, border_color = color.new(poi_label_color, 90), bgcolor = color.new(poi_label_color, 90), extend = extend.right, text = 'POI', text_halign = text.align_left, text_valign = text.align_center, text_color = poi_label_color, text_size = size.small, xloc = xloc.bar_index))

    else if box_type == -1 and okay_to_draw
        box.delete(array.get(box_array, array.size(box_array) - 1))
        f_array_add_pop(box_array, box.new(left = box_left, top = box_top, right = box_right, bottom = box_bottom, border_color = demand_outline_color, bgcolor = demand_color, extend = extend.right, text = 'DESTEK', text_halign = text.align_center, text_valign = text.align_center, text_color = poi_label_color, text_size = size.small, xloc = xloc.bar_index))

        box.delete(array.get(label_array, array.size(label_array) - 1))
        f_array_add_pop(label_array, box.new(left = box_left, top = poi, right = box_right, bottom = poi, border_color = color.new(poi_label_color, 90), bgcolor = color.new(poi_label_color, 90), extend = extend.right, text = 'POI', text_halign = text.align_left, text_valign = text.align_center, text_color = poi_label_color, text_size = size.small, xloc = xloc.bar_index))


f_sd_to_bos(box_array, bos_array, label_array, zone_type) =>

    if zone_type == 1
        for i = 0 to array.size(box_array) - 1 by 1
            level_to_break = box.get_top(array.get(box_array, i))
            if close >= level_to_break
                copied_box = box.copy(array.get(box_array, i))
                f_array_add_pop(bos_array, copied_box)
                mid = (box.get_top(array.get(box_array, i)) + box.get_bottom(array.get(box_array, i))) / 2
                box.set_top(array.get(bos_array, 0), mid)
                box.set_bottom(array.get(bos_array, 0), mid)
                box.set_extend(array.get(bos_array, 0), extend.none)
                box.set_right(array.get(bos_array, 0), bar_index)
                box.set_text(array.get(bos_array, 0), 'BOS')
                box.set_text_color(array.get(bos_array, 0), bos_label_color)
                box.set_text_size(array.get(bos_array, 0), size.small)
                box.set_text_halign(array.get(bos_array, 0), text.align_center)
                box.set_text_valign(array.get(bos_array, 0), text.align_center)
                box.delete(array.get(box_array, i))
                box.delete(array.get(label_array, i))


    if zone_type == -1
        for i = 0 to array.size(box_array) - 1 by 1
            level_to_break = box.get_bottom(array.get(box_array, i))
            if close <= level_to_break
                copied_box = box.copy(array.get(box_array, i))
                f_array_add_pop(bos_array, copied_box)
                mid = (box.get_top(array.get(box_array, i)) + box.get_bottom(array.get(box_array, i))) / 2
                box.set_top(array.get(bos_array, 0), mid)
                box.set_bottom(array.get(bos_array, 0), mid)
                box.set_extend(array.get(bos_array, 0), extend.none)
                box.set_right(array.get(bos_array, 0), bar_index)
                box.set_text(array.get(bos_array, 0), 'BOS')
                box.set_text_color(array.get(bos_array, 0), bos_label_color)
                box.set_text_size(array.get(bos_array, 0), size.small)
                box.set_text_halign(array.get(bos_array, 0), text.align_center)
                box.set_text_valign(array.get(bos_array, 0), text.align_center)
                box.delete(array.get(box_array, i))
                box.delete(array.get(label_array, i))



f_extend_box_endpoint(box_array) =>

    for i = 0 to array.size(box_array) - 1 by 1
        box.set_right(array.get(box_array, i), bar_index + 100)


atr = ta.atr(50)

swing_high_pivot = ta.pivothigh(high, swing_length, swing_length)
swing_low_pivot = ta.pivotlow(low, swing_length, swing_length)

var swing_high_values = array.new_float(5, 0.00)
var swing_low_values = array.new_float(5, 0.00)

var swing_high_bns = array.new_int(5, 0)
var swing_low_bns = array.new_int(5, 0)

var current_supply_box = array.new_box(history_of_demand_to_keep, na)
var current_demand_box = array.new_box(history_of_demand_to_keep, na)

var current_supply_poi = array.new_box(history_of_demand_to_keep, na)
var current_demand_poi = array.new_box(history_of_demand_to_keep, na)

var supply_bos = array.new_box(5, na)
var demand_bos = array.new_box(5, na)

if not na(swing_high_pivot)
    f_array_add_pop(swing_high_values, swing_high_pivot)
    f_array_add_pop(swing_high_bns, bar_index[swing_length])
    f_supply_demand(swing_high_values, swing_high_bns, current_supply_box, current_supply_poi, 1, atr)

else if not na(swing_low_pivot)
    f_array_add_pop(swing_low_values, swing_low_pivot)
    f_array_add_pop(swing_low_bns, bar_index[swing_length])
    f_supply_demand(swing_low_values, swing_low_bns, current_demand_box, current_demand_poi, -1, atr)


f_sd_to_bos(current_supply_box, supply_bos, current_supply_poi, 1)
f_sd_to_bos(current_demand_box, demand_bos, current_demand_poi, -1)

f_extend_box_endpoint(current_supply_box)
f_extend_box_endpoint(current_demand_box)

ema200 = ta.ema(close, 200)
ema377 = ta.ema(close, 377)
ema610 = ta.ema(close, 610)

plot(ema200, color = color.blue, linewidth = 3, title = 'EMA 200')
plot(ema377, color = color.purple, linewidth = 4, title = 'EMA 377')
plot(ema610, color = color.orange, linewidth = 4, title = 'EMA 610')

month_high = request.security(syminfo.tickerid, '12M', high)
month_low = request.security(syminfo.tickerid, '12M', low)

fib_23_6 = month_low + (month_high - month_low) * 0.236
fib_38_2 = month_low + (month_high - month_low) * 0.382
fib_50 = month_low + (month_high - month_low) * 0.5
fib_61_8 = month_low + (month_high - month_low) * 0.618
fib_78_6 = month_low + (month_high - month_low) * 0.786

line.new(x1 = bar_index[1], y1 = fib_23_6, x2 = bar_index - zone_extension * 3, y2 = fib_23_6, color = color.black, width = 2, style = line.style_solid)
line.new(x1 = bar_index[1], y1 = fib_38_2, x2 = bar_index - zone_extension * 3, y2 = fib_38_2, color = color.black, width = 2, style = line.style_solid)
line.new(x1 = bar_index[1], y1 = fib_50, x2 = bar_index - zone_extension * 3, y2 = fib_50, color = color.black, width = 2, style = line.style_solid)
line.new(x1 = bar_index[1], y1 = fib_61_8, x2 = bar_index - zone_extension * 3, y2 = fib_61_8, color = color.black, width = 2, style = line.style_solid)
line.new(x1 = bar_index[1], y1 = fib_78_6, x2 = bar_index - zone_extension * 3, y2 = fib_78_6, color = color.black, width = 2, style = line.style_solid)


// ============================================================
// WEBHOOK ENTEGRASYONU - ML MODEL İÇİN
// ============================================================

// EMA Uzaklıkları
dist_ema_200 = (close - ema200) / ema200
dist_ema_377 = (close - ema377) / ema377
dist_ema_610 = (close - ema610) / ema610

// EMA Gap'ler
ema_200_377_gap = math.abs(ema200 - ema377) / close
ema_377_610_gap = math.abs(ema377 - ema610) / close
ema_all_gap = math.abs(ema200 - ema610) / close

// EMA Yakınsama
emas_converging = ema_all_gap < 0.02 ? 1 : 0

// EMA Destek/Direnç
near_threshold = 0.02
ema_200_support = dist_ema_200 > 0 and dist_ema_200 < near_threshold ? 1 : 0
ema_200_resistance = dist_ema_200 < 0 and math.abs(dist_ema_200) < near_threshold ? 1 : 0
ema_377_support = dist_ema_377 > 0 and dist_ema_377 < near_threshold ? 1 : 0
ema_377_resistance = dist_ema_377 < 0 and math.abs(dist_ema_377) < near_threshold ? 1 : 0
ema_610_support = dist_ema_610 > 0 and dist_ema_610 < near_threshold ? 1 : 0
ema_610_resistance = dist_ema_610 < 0 and math.abs(dist_ema_610) < near_threshold ? 1 : 0

// Destek Gücü
support_strength = ema_200_support * 1 + ema_377_support * 2 + ema_610_support * 3 + emas_converging * 2
resistance_strength = ema_200_resistance * 1 + ema_377_resistance * 2 + ema_610_resistance * 3 + emas_converging * 2
near_ema_support = support_strength > 0 ? 1 : 0
near_ema_resistance = resistance_strength > 0 ? 1 : 0
super_support_zone = emas_converging == 1 and support_strength >= 3 ? 1 : 0

// EMA Durumları
above_ema_200 = close > ema200 ? 1 : 0
above_ema_377 = close > ema377 ? 1 : 0
above_ema_610 = close > ema610 ? 1 : 0
above_all_emas = close > ema200 and close > ema377 and close > ema610 ? 1 : 0
ema_stack = ema200 > ema377 and ema377 > ema610 ? 1 : 0

// POI - Destek/Direnç (supply/demand box'larından al)
// En yakın direnç POI'si (supply box)
supply_box = array.get(current_supply_box, 0)
nearest_resistance = not na(supply_box) ? (box.get_top(supply_box) + box.get_bottom(supply_box)) / 2 : close * 1.1

// En yakın destek POI'si (demand box)
demand_box = array.get(current_demand_box, 0)
nearest_support = not na(demand_box) ? (box.get_top(demand_box) + box.get_bottom(demand_box)) / 2 : close * 0.9

dist_to_resistance = (nearest_resistance - close) / close
dist_to_support = (close - nearest_support) / close
near_support = dist_to_support < 0.02 ? 1 : 0
near_resistance = dist_to_resistance < 0.02 ? 1 : 0

// Trailing Stop Uzaklığı
dist_to_stop = (close - xATRTrailingStop) / close

// === WEBHOOK JSON MESAJI ===
// Pine Script v6'da string parça parça birleştirilmeli
var string webhook_message = ""
if buy
    webhook_message := '{"ticker":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"signal":"BUY",'
    webhook_message := webhook_message + '"dist_ema_200":' + str.tostring(dist_ema_200) + ',"dist_ema_377":' + str.tostring(dist_ema_377) + ',"dist_ema_610":' + str.tostring(dist_ema_610) + ','
    webhook_message := webhook_message + '"ema_200_377_gap":' + str.tostring(ema_200_377_gap) + ',"ema_377_610_gap":' + str.tostring(ema_377_610_gap) + ',"ema_all_gap":' + str.tostring(ema_all_gap) + ','
    webhook_message := webhook_message + '"emas_converging":' + str.tostring(emas_converging) + ',"ema_200_support":' + str.tostring(ema_200_support) + ',"ema_200_resistance":' + str.tostring(ema_200_resistance) + ','
    webhook_message := webhook_message + '"ema_377_support":' + str.tostring(ema_377_support) + ',"ema_377_resistance":' + str.tostring(ema_377_resistance) + ','
    webhook_message := webhook_message + '"ema_610_support":' + str.tostring(ema_610_support) + ',"ema_610_resistance":' + str.tostring(ema_610_resistance) + ','
    webhook_message := webhook_message + '"support_strength":' + str.tostring(support_strength) + ',"resistance_strength":' + str.tostring(resistance_strength) + ','
    webhook_message := webhook_message + '"near_ema_support":' + str.tostring(near_ema_support) + ',"near_ema_resistance":' + str.tostring(near_ema_resistance) + ','
    webhook_message := webhook_message + '"super_support_zone":' + str.tostring(super_support_zone) + ',"above_ema_200":' + str.tostring(above_ema_200) + ','
    webhook_message := webhook_message + '"above_ema_377":' + str.tostring(above_ema_377) + ',"above_ema_610":' + str.tostring(above_ema_610) + ','
    webhook_message := webhook_message + '"above_all_emas":' + str.tostring(above_all_emas) + ',"ema_stack":' + str.tostring(ema_stack) + ','
    webhook_message := webhook_message + '"dist_to_resistance":' + str.tostring(dist_to_resistance) + ',"dist_to_support":' + str.tostring(dist_to_support) + ','
    webhook_message := webhook_message + '"near_support":' + str.tostring(near_support) + ',"near_resistance":' + str.tostring(near_resistance) + ','
    webhook_message := webhook_message + '"stoch_k":' + str.tostring(k) + ',"stoch_d":' + str.tostring(d) + ','
    webhook_message := webhook_message + '"dist_to_stop":' + str.tostring(dist_to_stop) + ',"secret":"your_secret_key_here"}'

// === ALERTS ===
// Orijinal alertler
alertcondition(buy, 'UT Long', 'UT Long')
alertcondition(sell, 'UT Short', 'UT Short')

// Webhook alert - AL sinyali geldiğinde (webhook_message yukarıdaki if buy bloğunda oluşturuldu)
if buy
    alert(webhook_message, alert.freq_once_per_bar_close)
